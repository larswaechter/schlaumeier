# LLM provider: "openai", "anthropic", "ollama" or "custom" (OpenAI compatible API)
LLM_PROVIDER=openai

# How the screen is read: "tesseract" (OCR) or "vision" (the LLM reads the screenshot)
SCREEN_READER=tesseract

# OpenAI ChatGPT API Key & language model
GPT_KEY=
GPT_MODEL=gpt-5.6-terra

# Anthropic Claude API Key & language model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama language model & URL
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_URL=http://localhost:11434/v1

# Any other OpenAI compatible API: URL, language model & optional key
CUSTOM_URL=
CUSTOM_MODEL=
CUSTOM_KEY=

# Tesseract Language (only used by SCREEN_READER=tesseract)
TESSERACT_LANG=eng

# A +/- range for adding randomness when triggering touch events
TOUCH_RANDOMNESS=5

# Text area slices => Format: hFrom:hTo-wFrom:wTo
SLICE_Q=300:1000-0:1080
SLICE_ANSW_A=1040:1280-50:1020
SLICE_ANSW_B=1335:1575-50:1020
SLICE_ANSW_C=1630:1870-50:1020
SLICE_ANSW_D=1925:2165-50:1020